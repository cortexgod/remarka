{
  "_comment": "Заполненные паузы. Регулярки применяются к norm без дефисов («э-э» → «ээ»). Одиночное «а» — союз, не филлер, поэтому для «а» требуем повтор.",
  "patterns": [
    { "regex": "^э+$", "label": "э-э" },
    { "regex": "^э+м+$", "label": "э-м" },
    { "regex": "^м+$", "label": "м-м" },
    { "regex": "^мм+$", "label": "м-м" },
    { "regex": "^аа+$", "label": "а-а" },
    { "regex": "^хм+$", "label": "хм" },
    { "regex": "^гм+$", "label": "гм" },
    { "regex": "^ым+$", "label": "ым" },
    { "regex": "^ээ+м*$", "label": "э-э" },
    { "regex": "^мэ+$", "label": "м-э" },
    { "regex": "^ну+у+$", "label": "ну-у" }
  ]
}
