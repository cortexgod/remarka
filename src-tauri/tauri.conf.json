{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remarka",
  "version": "0.4.0",
  "identifier": "com.remarka.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Ремарка",
        "url": "index.html#/",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "visible": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "overlay",
        "title": "Ремарка — запись",
        "url": "index.html#/overlay",
        "width": 280,
        "height": 72,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "focus": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/remarka-tap"
    ],
    "macOS": {
      "minimumSystemVersion": "14.4"
    },
    "resources": {
      "../engine/dist/remarka-engine/": "engine-dist/"
    }
  }
}
